# Server
PORT=4174
HOST=0.0.0.0
KH_DATA_DIR=./data
KH_JWT_SECRET=change-me-to-a-long-random-string
# 部署到公网后建议配置，例如 https://knowledge.example.com；为空时按请求 Host 推断。
KH_PUBLIC_BASE_URL=

# 数据库（必填）：PostgreSQL 连接串。
# 默认值与仓库自带的 docker-compose.yml 一致 —— 用 `npm run db:up` 起库即可零配置连上。
DATABASE_URL=postgres://postgres:khpw@127.0.0.1:5432/knowledge_hub

# PostgreSQL（测试用，单元测试始终使用外部 PG 以保证 schema 隔离）
KH_TEST_DATABASE_URL=postgres://postgres:khpw@127.0.0.1:5432/knowledge_hub_test

# ── Docker 部署（应用进容器、数据库用外部 PG、不使用 5432）──
# 容器内 127.0.0.1 指向容器自身，连宿主机 PG 要用 host.docker.internal；端口用你的非 5432 端口（示例 5544）。
# 数据库在独立服务器时，把 host.docker.internal 换成那台 DB 的 IP/域名。部署时取消注释并覆盖上面的 DATABASE_URL：
# DATABASE_URL=postgres://postgres:khpw@host.docker.internal:5544/knowledge_hub
# docker-compose.prod.yml 自带 PostgreSQL 时必须显式配置，建议生产环境改成长随机值。
# POSTGRES_PASSWORD=change-me-to-a-long-random-password
# APP_HOST_PORT=4174

# Web 上传原始资料限制。
# 默认单文件 2GB；如果部署在 Nginx/云网关后，还需要同步调大代理的上传上限。
KH_UPLOAD_MAX_FILE_BYTES=2147483648
KH_UPLOAD_MAX_FILES=20000
KH_UPLOAD_MAX_FIELDS=200
KH_UPLOAD_MAX_PARTS=20200

# Knowledge Builder
# extract 阶段调用 LLM 时的输出上限（tokens）。文档越长越复杂越要调高。
# Anthropic Sonnet/Opus 支持 64K+；OpenAI gpt-4.1 系列 16K+。
KH_KB_EXTRACT_MAX_TOKENS=4096

# "测试模型连接"按钮的探针请求 max_tokens，保持小值即可。
KH_MODEL_PROBE_MAX_TOKENS=1

# OpenAI 兜底（可选）：仅在前端未显式选择 LLM provider 时使用。
# 前端「知识构建 → 高级选项」配置的 modelConfig 会覆盖这里。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# 自动化发布：默认开启。scoped build 生成的 revision draft 只有通过 autoMode 资格检查才会自动发布。
KH_AUTO_PUBLISH_REVISIONS=true

# 上传即流转：策划导入新资料版本后，自动触发增量构建 → lint → 发布（flywheel sync）。
# 默认开启；设为 false 则上传后需手动点「一键同步」。仅当相对上一版本确有变更才会触发。
KH_AUTO_BUILD_ON_UPLOAD=true

# 周期性知识健康巡检：每隔 N 小时自动对每个项目跑一次 lint / trust / 过期审计巡检
# （「知识过期」是时间相关的，只有定期触发才能及时发现）。结果落 knowledge_lint.health_checked
# 事件，进入平台自动化历史可审阅。设为 0 关闭。默认 24 小时。
KH_HEALTH_SWEEP_INTERVAL_HOURS=24

# 构建阶段默认只产出质量报告，不主动生成审核任务；审核任务主要由 Agent 反馈回流产生。
# 如需恢复旧行为，可设为 true。
KH_GENERATE_BUILD_REVIEW_TASKS=false

# ── LLM 自动修复（Auto-Remediation）──
# 默认启用。开启后，Agent 单次负面反馈就会触发 LLM 分析：
#   - 高置信度（>= KH_AUTO_REMEDIATION_CONFIDENCE_THRESHOLD）→ 自动生成 annotation override
#     并触发 scoped rebuild → revision draft → auto-publish（信任分达标时）
#   - 低置信度 → 把 LLM 建议追加到 task.candidates，等人类审核
# LLM 优先级：KH_AUTO_REMEDIATION_LLM_* > 最近一次成功构建的 modelConfig（key 从环境变量补） > OPENAI_API_KEY
# 如果三级全没配，会跳过并写警告日志，不影响其他功能。
KH_AUTO_REMEDIATION_ENABLED=true
# Knowledge Lint 别名自动修复：把「Data Dependencies 未解析到表」「图谱 configured_in 悬空边」
# 这类中文表名解析失败的问题，交给 LLM 映射到真实 canonical 表名 → 写入翻译表(table_aliases)
# → 全量重建并自动发布(可回滚)。canonical 必须命中现有表名，否则拒绝并留给人工。复用
# KH_AUTO_REMEDIATION_LLM_* / 置信阈值配置。
KH_AUTO_ALIAS_REMEDIATION_ENABLED=true
KH_AUTO_REMEDIATION_CONFIDENCE_THRESHOLD=0.85
# 显式指定 LLM 供应商配置（覆盖上述兜底链路）
# provider: anthropic | openai-compatible
# KH_AUTO_REMEDIATION_LLM_PROVIDER=anthropic
# KH_AUTO_REMEDIATION_LLM_BASE_URL=https://api.anthropic.com/v1
# KH_AUTO_REMEDIATION_LLM_MODEL=claude-sonnet-4-5
# KH_AUTO_REMEDIATION_LLM_API_KEY=
