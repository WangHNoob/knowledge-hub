# Server
PORT=4174
HOST=0.0.0.0
KH_DATA_DIR=./data
KH_JWT_SECRET=change-me-to-a-long-random-string
# 部署到公网后建议配置，例如 https://knowledge.example.com；为空时按请求 Host 推断。
KH_PUBLIC_BASE_URL=

# 数据库（必填）：PostgreSQL 连接串。
# 默认值与仓库自带的 docker-compose.yml 一致 —— 用 `npm run db:up` 起库即可零配置连上。
DATABASE_URL=postgres://postgres:khpw@127.0.0.1:5432/knowledge_hub

# PostgreSQL（测试用，单元测试始终使用外部 PG 以保证 schema 隔离）
KH_TEST_DATABASE_URL=postgres://postgres:khpw@127.0.0.1:5432/knowledge_hub_test

# ── Docker 部署（应用进容器、数据库用外部 PG、不使用 5432）──
# 容器内 127.0.0.1 指向容器自身，连宿主机 PG 要用 host.docker.internal；端口用你的非 5432 端口（示例 5544）。
# 数据库在独立服务器时，把 host.docker.internal 换成那台 DB 的 IP/域名。部署时取消注释并覆盖上面的 DATABASE_URL：
# DATABASE_URL=postgres://postgres:khpw@host.docker.internal:5544/knowledge_hub
# docker-compose.prod.yml 自带 PostgreSQL 时必须显式配置，建议生产环境改成长随机值。
# POSTGRES_PASSWORD=change-me-to-a-long-random-password
# APP_HOST_PORT=4174

# Web 上传原始资料限制。
# 默认单文件 2GB；如果部署在 Nginx/云网关后，还需要同步调大代理的上传上限。
KH_UPLOAD_MAX_FILE_BYTES=2147483648
KH_UPLOAD_MAX_FILES=20000
KH_UPLOAD_MAX_FIELDS=200
KH_UPLOAD_MAX_PARTS=20200

# Knowledge Builder
# extract 阶段调用 LLM 时的输出上限（tokens）。文档越长越复杂越要调高。
# 注意：推理模型（如 deepseek-v4-flash）的 thinking 会占用 max_tokens——4096 时长文档
# 的 content 会被耗尽（No output generated），16384 实测可完整输出抽取 JSON。
KH_KB_EXTRACT_MAX_TOKENS=16384

# "测试模型连接"按钮的探针请求 max_tokens，保持小值即可。
# 注：推理模型（会先输出 thinking）即使在极小 max_tokens 下只产出 thinking、无 text，
# 只要 HTTP 返回 2xx 就判为连接成功，无需为此调大。
KH_MODEL_PROBE_MAX_TOKENS=1

# 每次 LLM 请求超时（毫秒）。防止慢/不可达的供应商让构建无限挂起、无法中止。默认 300000（5 分钟）。
# 推理模型单篇抽取实测约 60-120s（thinking + 输出），长文档需更大余量。
KH_LLM_REQUEST_TIMEOUT_MS=300000
# "测试模型连接"探针超时（毫秒），比正式请求短，避免测试连接长时间转圈。默认 30000。
KH_MODEL_PROBE_TIMEOUT_MS=30000

# OpenAI 兜底（可选）：仅在前端未显式选择 LLM provider 时使用。
# 前端「知识构建 → 高级选项」配置的 modelConfig 会覆盖这里。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL：不设则兜底为 gpt-4.1-mini。若 OPENAI_BASE_URL 指向非 OpenAI 供应商，
# 必须设为该供应商的真实模型名（例如 DeepSeek 用 deepseek-v4-flash / deepseek-v4-pro），
# 否则会把 gpt-4.1-mini 发过去被 400 拒绝。
# OPENAI_MODEL=

# 自动化发布：默认开启。scoped build 生成的 revision draft 只有通过 autoMode 资格检查才会自动发布。
# 策略档（flywheel 02-P3）：off=全关；revisions=修订版自动发布（默认，首次发布/结构性变更仍人工）；
# revisions_and_new=修订 + 新发布都自动。旧布尔 KH_AUTO_PUBLISH_REVISIONS=false 等价 off。
KH_AUTO_PUBLISH_REVISIONS=true
# KH_AUTO_PUBLISH_MODE=revisions

# 自动发布前跑检索黄金集回归闸（默认开启；hit@k / citation 不达标会 skip 自动发布）。
# 黄金集缺失时该闸空转（不拦），因此规则档会同时用发布级质量回归门禁兜底。
KH_RETRIEVAL_EVAL_ENABLED=true
# KH_RETRIEVAL_EVAL_GOLD_PATH=evals/retrieval-gold.json
# KH_RETRIEVAL_EVAL_MIN_HIT_AT_K=0.85
# KH_RETRIEVAL_EVAL_MIN_CITATION=0
# KH_RETRIEVAL_EVAL_BLOCK_ON_REGRESSION=true
# 自动发布后跑一次检索 eval，命中率低于门槛 → 自动回滚到父发布（发布后闭环保险）。
# KH_AUTO_ROLLBACK_ON_REGRESSION=true

# 上传即流转：策划导入新资料版本后，自动触发增量构建 → lint → 发布（flywheel sync）。
# 默认开启；设为 false 则上传后需手动点「一键同步」。仅当相对上一版本确有变更才会触发。
KH_AUTO_BUILD_ON_UPLOAD=true

# 周期性知识健康巡检：每隔 N 小时自动对每个项目跑一次 lint / trust / 过期审计巡检
# （「知识过期」是时间相关的，只有定期触发才能及时发现）。结果落 knowledge_lint.health_checked
# 事件，进入平台自动化历史可审阅。设为 0 关闭。默认 24 小时。
KH_HEALTH_SWEEP_INTERVAL_HOURS=24

# 构建阶段默认只产出质量报告，不主动生成审核任务；审核任务主要由 Agent 反馈回流产生。
# 如需恢复旧行为，可设为 true。
KH_GENERATE_BUILD_REVIEW_TASKS=false

# ── 策划可用 / 简单模式（见 docs/planner-ops.md）──
# UI：simple=工作台导航（默认）；full=完整飞轮/治理台。admin 可在前端临时切换。
KH_UI_MODE=simple
# 规则化自动发布（默认）：信任下降 / 发布级质量回归 / 待审纠正 / 删除均会阻断自动发布，
# 保证「知识质量只升不降」。试点期想恢复宽松放行可设 KH_PUBLISH_RELAXED=true。
KH_PUBLISH_RELAXED=false
# 自动发布的最低可信度门槛（组件级）。当前库内组件约 0.55–0.65，默认 0.5。
KH_MIN_AUTO_PUBLISH_SCORE=0.5
# 发布级质量回归门禁：quality_gate 对比父发布（averageScore 下降 / blockingCount 上升）即挡自动发布。
# KH_BLOCK_ON_QUALITY_REGRESSION=true
# 同一知识缺口重复反馈 ≥N 次且无源 → 自动 dismiss（受控收敛）。
# KH_GAP_FILL_AUTO_DISMISS_THRESHOLD=3
# 服务器上策划资料 SVN 工作副本；开启后工作台可「从 SVN 同步」，计划任务见 scripts/svn-sync-ingest.mjs
# KH_SVN_SYNC_ENABLED=true
# KH_SVN_WC_PATH=
# KH_SVN_UPDATE_CMD=svn update
# 计划任务鉴权（调用已启动的 Hub）：
# KH_OPS_BASE_URL=http://127.0.0.1:4174
# KH_OPS_TOKEN=
# KH_OPS_USER=admin
# KH_OPS_PASSWORD=
# KH_OPS_PROJECT_ID=default_project

# ── LLM 自动修复（Auto-Remediation）──
# 策划可用模式默认关闭，避免难懂的自动改写。完整飞轮治理可按需开启。
# 开启后，Agent 单次负面反馈会触发 LLM 分析：
#   - 高置信度（>= KH_AUTO_REMEDIATION_CONFIDENCE_THRESHOLD）→ 自动生成 annotation override
#     并触发 scoped rebuild → revision draft → auto-publish（信任分达标时）
#   - 低置信度 → 把 LLM 建议追加到 task.candidates，等人类审核
# LLM 优先级：KH_AUTO_REMEDIATION_LLM_* > 最近一次成功构建的 modelConfig（key 从环境变量补） > OPENAI_API_KEY
# 如果三级全没配，会跳过并写警告日志，不影响其他功能。
KH_AUTO_REMEDIATION_ENABLED=false
# Knowledge Lint 别名自动修复：把「Data Dependencies 未解析到表」「图谱 configured_in 悬空边」
# 这类中文表名解析失败的问题，交给 LLM 映射到真实 canonical 表名 → 写入翻译表(table_aliases)
# → 全量重建并自动发布(可回滚)。canonical 必须命中现有表名，否则拒绝并留给人工。复用
# KH_AUTO_REMEDIATION_LLM_* / 置信阈值配置。
KH_AUTO_ALIAS_REMEDIATION_ENABLED=false
KH_AUTO_REMEDIATION_CONFIDENCE_THRESHOLD=0.85
# 显式指定 LLM 供应商配置（覆盖上述兜底链路）
# 自动修复置信门槛（flywheel 02-P4）：
# annotation_override 通用门槛（默认 0.85）
# KH_AUTO_REMEDIATION_CONFIDENCE_THRESHOLD=0.85
# document_rewrite 整页重写单独门槛（默认 0.9，结构/事实/引用三道闸全部通过才自动落稿）
KH_AUTO_REMEDIATION_DOC_REWRITE_CONFIDENCE=0.9
# provider: anthropic | openai-compatible
# KH_AUTO_REMEDIATION_LLM_PROVIDER=anthropic
# KH_AUTO_REMEDIATION_LLM_BASE_URL=https://api.anthropic.com/v1
# KH_AUTO_REMEDIATION_LLM_MODEL=claude-sonnet-4-5
# KH_AUTO_REMEDIATION_LLM_API_KEY=

# MCP stdio：生产建议 KH_MCP_STDIO_REQUIRE_TOKEN=true，并配置服务令牌。
# KH_MCP_SERVICE_TOKEN=
# KH_MCP_STDIO_REQUIRE_TOKEN=false

# MCP HTTP 进程内限流（网关限流仍建议前置）。0 关闭。
# KH_MCP_RATE_LIMIT_MAX=120
# KH_MCP_RATE_LIMIT_WINDOW_MS=60000

# 多实例事件投递：inline（默认）| outbox
# KH_EVENT_BUS_MODE=inline
# KH_EVENT_OUTBOX_INTERVAL_MS=1000

# 组件可见性：在 asset_components.quality.visibility 设 public|internal|restricted
# MCP 检索前按 agentRole 过滤（viewer=public，developer/agent=public+internal，admin=全部）

# 稠密向量索引方法（flywheel 02-P2）：fastembed（默认，真实 embedding，需
# @xenova/transformers 可用且模型可下载；构建失败自动回退 hashing_trick v1 并告警）| hashing_trick
# OKF_DENSE_METHOD=fastembed
# HuggingFace 模型仓库镜像（默认 huggingface.co；国内部署可设 hf-mirror.com）
# OKF_HF_ENDPOINT=https://hf-mirror.com
